<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WebDroid" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/canvas_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">@color/ink_dark</item>
    </style>

    <style name="Theme.WebDroid.WebApp" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/web_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorAccent">@color/canvas</item>
    </style>
</resources>
